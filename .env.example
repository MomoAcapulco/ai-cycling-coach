# AI Cycling Coach - example configuration. init.sh copies it to .env on first install.
# No secrets here. Each key appears ONCE: with a duplicated key the last one wins silently.
# Devices are found automatically (see docs/adr/ADR-002-autodiscovery.md) and remembered in DEVICES_FILE.
# Your data (sessions, recordings, devices, settings, profile) lives in ai-cycling-coach-data NEXT TO the
# version folders (~/dev/ai-cycling-coach-data); AI_COACH_HOME chooses another folder.
# AI_COACH_HOME=~/dev/ai-cycling-coach-data
# The *_DEVICE_ID keys are optional overrides: if set, only that device is used.
# DEVICES_FILE=<data home>/devices.json

# ---- Network (all services listen on localhost only) ----
SERVER_HOST=127.0.0.1
SERVER_PORT=8081
TRAINER_HOST=127.0.0.1
TRAINER_PORT=8766
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
# Optional overrides:
# TRAINER_ADAPTER_URL=http://127.0.0.1:8766
# BACKEND_URL=http://127.0.0.1:8081

# ---- Trainer source ----
# WAHOO:     the trainer over Bluetooth (the default if this key is missing). Replays are opened from
#            Sesiones or Rutas in the app, not from here.
# SIMULATOR: synthetic data, no Bluetooth: for DEVELOPMENT only (it is not offered in the app)
# REPLAY:    start playing a recorded CSV (REPLAY_FILE: a file name in the recordings folder, or an absolute path)
TRAINER_MODE=WAHOO
# REPLAY_FILE=session_20261113_130000.csv
# Devices are found by TYPE (any brand) and remembered; with several unknown ones nearby you choose in Ajustes.
# (WAHOO_DEVICE_NAME / HR_DEVICE_NAME of earlier versions are ignored.)
# WAHOO_DEVICE_ID=<optional, Mac-specific BLE UUID>

# ---- Heart-rate strap (independent of the trainer; ignored in REPLAY) ----
HR_ENABLED=false
# HR_DEVICE_ID=<optional, Mac-specific BLE UUID>

# ---- Raw Bluetooth capture (WAHOO only, diagnostics) ----
# Sessions are started/finished from the panel and always saved as CSV + summary.
# true: also save every Bluetooth message of each session (and the trainer capabilities).
RECORD_ENABLED=false
# Only used by the supervised CONTROL_TEST below (fixed 600 s recording).
RECORD_SECONDS=600
# RECORD_DIR=/absolute/path/to/recordings   (default <data home>/recordings)

# ---- EXPERIMENTAL physical control (off) ----
# true: 5 min baseline + 5 min grades 1/2/3/2/0 %. Supervised only, after reading the instructions.
# Requires TRAINER_MODE=WAHOO, RECORD_ENABLED=true and RECORD_SECONDS=600.
CONTROL_TEST_ENABLED=false

# ---- Native virtual shifting on the trainer (Zwift Cog, TRAINER_MODE=WAHOO only) ----
# true: the gears (controllers and panel buttons) change the trainer resistance. Also in the Settings page.
GEAR_CONTROL_ENABLED=false

# ---- Zwift controllers (buttons) ----
# true: find the left/right controllers automatically (type byte, else first button press).
ZWIFT_ENABLED=false
# ZWIFT_LEFT_DEVICE_ID=<optional, Mac-specific BLE UUID>
# ZWIFT_RIGHT_DEVICE_ID=<optional, Mac-specific BLE UUID>
