# Copy to .env and change values if needed. No secrets here.
SERVER_HOST=127.0.0.1
SERVER_PORT=8081
TRAINER_HOST=127.0.0.1
TRAINER_PORT=8766
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
# Optional override: TRAINER_ADAPTER_URL=http://127.0.0.1:8766
# Optional override: BACKEND_URL=http://127.0.0.1:8081
# Bluetooth reading: SIMULATOR (default), WAHOO or REPLAY
TRAINER_MODE=REPLAY
WAHOO_DEVICE_NAME="KICKR CORE"
# WAHOO_DEVICE_ID=optional Mac-specific BLE UUID
# iGPSPORT HR50 sensor (independent of the trainer)
HR_ENABLED=false
HR_DEVICE_NAME=HR50
# HR_DEVICE_ID=optional Mac-specific BLE UUID

# WAHOO: automatically capture 10 minutes (CSV + all raw BLE notifications + capabilities), starting at first movement
RECORD_ENABLED=true
RECORD_SECONDS=600
# RECORD_DIR=/absolute/path/to/recordings
# REPLAY: offline playback of a recorded file (no BLE)
# REPLAY_FILE=/absolute/path/to/ride_YYYYMMDD_HHMMSS.csv

# EXPERIMENTAL PHYSICAL CONTROL (off by default). Enables 5min baseline + 5min ramp (1/2/3/2/0%).
# Must be supervised and explicitly enabled, after reviewing instructions.
CONTROL_TEST_ENABLED=false

# v4 example replay: the bundled 10-minute real session (relative to project root)
REPLAY_FILE=trainer-adapter/recordings/ride_20261111_192250_936238.csv
CONTROL_TEST_ENABLED=false
RECORD_ENABLED=false
RECORD_SECONDS=600
ZWIFT_ENABLED=true
# Enable only when intentionally connecting real Zwift controls:
ZWIFT_LEFT_DEVICE_ID=FA4E0000-0000-4000-8000-C4F41263D137
ZWIFT_RIGHT_DEVICE_ID=FA4E0000-0000-4000-8000-5A32B13A42DE
